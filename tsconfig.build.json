{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "ts",
    "sourceMap": false,
    "inlineSources": false
  },
  "include": ["ts/**/*.ts"],
  "exclude": [
    "test",
    "node_modules",
    "dist",
    "third-party",
    "build",
    "scripts"
  ]
}
